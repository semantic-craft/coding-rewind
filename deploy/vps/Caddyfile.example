rewind.example.com {
	encode zstd gzip

	# Optional public Standard Webhooks route from Memos -> rewind-enricher
	handle /hooks/rewind* {
		rewrite * /webhook
		reverse_proxy 127.0.0.1:8090
	}

	# Streamable HTTP MCP endpoint (/mcp) requires unbuffered streaming
	handle /mcp* {
		reverse_proxy 127.0.0.1:5230 {
			flush_interval -1
		}
	}

	# Memos Web UI and REST API (/api/*)
	handle {
		reverse_proxy 127.0.0.1:5230
	}
}
