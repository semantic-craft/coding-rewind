# Pinned Memos release image & loopback host port (expose externally only via reverse proxy)
MEMOS_IMAGE=neosmemo/memos:26.11.0
MEMOS_BIND_ADDR=127.0.0.1
MEMOS_PORT=5230

# Memos personal access token with MemoService read/write permissions
MEMOS_ACCESS_TOKEN=

# OpenAI-compatible Chat Completions endpoint & model (e.g. DashScope / OpenAI / Gemini)
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus

# Optional Standard Webhooks signing secret for public POST /hooks/rewind delivery
REWIND_WEBHOOK_SECRET=

# Internal Docker reconciliation poll interval in seconds
POLL_INTERVAL_SECONDS=5
