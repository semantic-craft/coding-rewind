# Pinned Memos release image, data directory, and loopback host ports (expose externally only via reverse proxy)
MEMOS_IMAGE=neosmemo/memos:26.11.0
MEMOS_DATA_DIR=./memos-data
MEMOS_BIND_ADDR=127.0.0.1
MEMOS_PORT=5230
ENRICHER_BIND_ADDR=127.0.0.1
ENRICHER_PORT=8090

# Memos personal access token with MemoService read/write permissions
MEMOS_ACCESS_TOKEN=

# OpenAI-compatible Chat Completions endpoint & model
# Defaults to DeepSeek official API (https://api.deepseek.com) with deepseek-flash (DeepSeek-V4.1-Flash)
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash

# AI summary language mode: auto (script-detected per clip) | zh-Hans | en
REWIND_SUMMARY_LANGUAGE=auto

# Optional Standard Webhooks signing secret for public POST /hooks/rewind delivery
REWIND_WEBHOOK_SECRET=

# Internal Docker reconciliation poll interval in seconds
POLL_INTERVAL_SECONDS=5
