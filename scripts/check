#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

echo "==> [1/6] Static hygiene and boundary guards"
if [[ ! -s "${REPO_ROOT}/lessons.md" ]]; then
  echo "FAIL: lessons.md is missing or empty at repository root" >&2
  exit 1
fi
if [[ ! -s "${REPO_ROOT}/AGENTS.md" ]]; then
  echo "FAIL: AGENTS.md is missing or empty at repository root" >&2
  exit 1
fi

python3 - <<'PY'
import pathlib
import re
import subprocess
import sys

root = pathlib.Path.cwd()
res = subprocess.run(
    ["git", "ls-files", "--cached", "--others", "--exclude-standard", "--", "Sources", "Tests", "scripts", "deploy", "extensions"],
    capture_output=True,
    text=True,
    check=True,
)
files = [line.strip() for line in res.stdout.splitlines() if line.strip()]

def is_excluded(rel_path: str) -> bool:
    if rel_path == "scripts/check":
        return True
    p = pathlib.Path(rel_path)
    parts = set(p.parts)
    if "Tests" in parts or "tests" in parts or "__tests__" in parts:
        return True
    name = p.name
    if (
        name.startswith("test_")
        or name.endswith("_test.py")
        or name.endswith("Tests.swift")
        or ".test." in name
        or name == "SyntheticDemoSeed.swift"
    ):
        return True
    return False

secret_re = re.compile(r"\b(sk-[A-Za-z0-9_-]{8,}|whsec_[A-Za-z0-9+/=_-]{8,})\b")
placeholder_re = re.compile(r"(your|example|replace|placeholder|changeme|dummy|xxx)", re.IGNORECASE)
ipv4_re = re.compile(
    r"(?:^|[^0-9.])((?:25[0-5]|2[0-4]\d|1?\d?\d)(?:\.(?:25[0-5]|2[0-4]\d|1?\d?\d)){3})(?:$|[^0-9.])"
)
allowed_ips = {"127.0.0.1", "0.0.0.0"}
normalizer_tokens = (
    "normalizeMemosBaseUrl",
    "normalizeBaseURLString",
    "saveMemosURLString",
    "readConfiguredMemosURLString",
    "_base_url",
)
suite_call_re = re.compile(r'UserDefaults\(\s*suiteName:\s*"([^"]+)"')
suite_decl_re = re.compile(r'\b(?:[A-Za-z0-9_]*(?:Suite|Domain)|suite|suiteName|domain)\s*=\s*"([^"]+)"')

errors: list[str] = []

for rel in files:
    if rel == "scripts/check":
        continue
    fpath = root / rel
    if not fpath.is_file():
        continue
    text = fpath.read_text(encoding="utf-8", errors="replace")

    if rel.startswith(("Sources/", "Tests/", "deploy/", "extensions/", "scripts/")):
        for lineno, line in enumerate(text.splitlines(), start=1):
            if "/api/v1/memos" in line and not any(tok in line for tok in normalizer_tokens):
                errors.append(f"{rel}:{lineno}: legacy /api/v1/memos endpoint detected (use /api/memos)")

    if rel.startswith("Tests/") and rel.endswith(".swift"):
        for lineno, line in enumerate(text.splitlines(), start=1):
            stripped = line.strip()
            if stripped.startswith("//"):
                continue
            if "UserDefaults.standard.removePersistentDomain" in line:
                errors.append(
                    f"{rel}:{lineno}: forbidden UserDefaults.standard.removePersistentDomain in Tests "
                    "(use UserDefaults(suiteName:)?.removePersistentDomain + CFPreferencesAppSynchronize)"
                )
            for pattern in (suite_call_re, suite_decl_re):
                for m in pattern.finditer(line):
                    dom = m.group(1)
                    if "." in dom and not dom.startswith("dev.codingrewind.qa."):
                        errors.append(
                            f"{rel}:{lineno}: test UserDefaults suite '{dom}' must start with 'dev.codingrewind.qa.'"
                        )

    if is_excluded(rel):
        continue
    is_example = rel.endswith(".example")
    is_bundle_builder = rel == "scripts/build-app-bundle.sh"

    for lineno, line in enumerate(text.splitlines(), start=1):
        stripped = line.strip()
        is_comment = stripped.startswith("#") or stripped.startswith("//")

        if not is_bundle_builder and ".build/CodingRewind.app" in line:
            errors.append(f"{rel}:{lineno}: hardcoded .build/CodingRewind.app in non-build path")

        if not is_comment and ("/tmp/" in line or "/private/tmp/" in line):
            if is_bundle_builder:
                if re.search(r"=\s*[\"']?(?:/private)?/tmp/", line) or re.search(
                    r"\bmktemp\b.*(?:/private)?/tmp", line
                ):
                    errors.append(f"{rel}:{lineno}: forbidden /tmp or /private/tmp build path")
            elif "hasPrefix(" not in line and "starts(with:" not in line:
                errors.append(f"{rel}:{lineno}: forbidden /tmp or /private/tmp path")

        for m in secret_re.finditer(line):
            tok = m.group(1)
            if is_example and placeholder_re.search(tok):
                continue
            errors.append(f"{rel}:{lineno}: literal secret token prefix detected ({tok[:8]}...)")

        if '"version"' not in line:
            for m in ipv4_re.finditer(line):
                ip = m.group(1)
                if ip not in allowed_ips:
                    errors.append(f"{rel}:{lineno}: hardcoded IP address detected ({ip})")

if errors:
    for err in errors:
        print(f"FAIL: {err}", file=sys.stderr)
    sys.exit(1)
PY

if [[ -f "${REPO_ROOT}/Package.swift" ]]; then
  echo "==> [2/6] Swift test suite"
  swift test
  VENDOR_TEST_LOG="$(mktemp "${REPO_ROOT}/.build/vendor-tests.XXXXXX")"
  trap 'rm -f "${VENDOR_TEST_LOG}"' EXIT
  swift test --package-path Vendor/KeyboardShortcuts 2>&1 | tee "${VENDOR_TEST_LOG}"
  python3 - "${VENDOR_TEST_LOG}" <<'PYTEST'
import pathlib
import re
import sys

output = pathlib.Path(sys.argv[1]).read_text()
if "Test Suite 'RunLoopMonitorTests' passed" not in output or not re.search(r"Test run with [1-9][0-9]* tests .*passed", output):
    sys.exit("FAIL: KeyboardShortcuts tests exited without complete XCTest and Swift Testing results")
PYTEST
  rm -f "${VENDOR_TEST_LOG}"
  trap - EXIT
  rm -rf "${REPO_ROOT}/.test-data"

  python3 - <<'PY_CLEANUP'
import pathlib
import sys
import time

pref_dir = pathlib.Path.home() / "Library" / "Preferences"
fixed_qa_suites = {
    "dev.codingrewind.qa.tests.plist",
    "dev.codingrewind.qa.appearance.plist",
    "dev.codingrewind.qa.appearance.popup.plist",
    "dev.codingrewind.qa.upgrade-integrity.plist",
    "dev.codingrewind.qa.shortcuts.8bf5238e9fb55904.plist",
    "dev.codingrewind.qa.shortcuts.a801eac0a75e043c.plist",
    "dev.codingrewind.qa.vendor-tests.plist",
}

for _ in range(10):
    for fname in fixed_qa_suites:
        p = pref_dir / fname
        if p.is_file() and p.stat().st_size in (42, 64):
            try:
                p.unlink()
            except OSError:
                pass
    for p in pref_dir.glob("dev.codingrewind.qa.shortcuts.*.plist"):
        if p.is_file() and p.stat().st_size in (42, 64):
            try:
                p.unlink()
            except OSError:
                pass
    if not any((pref_dir / fname).exists() for fname in fixed_qa_suites) and not list(pref_dir.glob("dev.codingrewind.qa.shortcuts.*.plist")):
        break
    time.sleep(0.15)

leaked_plists = sorted(
    set(pref_dir.glob("dev.codingrewind.qa.*.plist"))
    | set(pref_dir.glob("dev.codingrewind.tests.*.plist"))
)
if leaked_plists:
    names = ", ".join(p.name for p in leaked_plists)
    print(f"FAIL: QA/test preferences plist leaked in ~/Library/Preferences: {names}", file=sys.stderr)
    sys.exit(1)

dist_dir = pathlib.Path.cwd() / "dist"
if dist_dir.exists():
    print(f"FAIL: dist directory was created during test execution ({dist_dir})", file=sys.stderr)
    sys.exit(1)
PY_CLEANUP
else
  echo "==> [2/6] Swift test suite (skipped: no Package.swift)"
fi

if [[ -d "${REPO_ROOT}/deploy/vps/enricher" ]] && compgen -G "${REPO_ROOT}/deploy/vps/enricher/test_*.py" > /dev/null; then
  echo "==> [3/6] VPS AI Enricher unit tests"
  python3 -B -m unittest discover -s deploy/vps/enricher -p 'test_*.py'
else
  echo "==> [3/6] VPS AI Enricher unit tests (skipped: not present in this checkout)"
fi

if [[ -f "${REPO_ROOT}/extensions/web-clipper/test_extractors.mjs" ]]; then
  echo "==> [4/6] Web Clipper unit tests"
  node --test extensions/web-clipper/test_extractors.mjs
else
  echo "==> [4/6] Web Clipper unit tests (skipped: not present in this checkout)"
fi

echo "==> [5/6] Shell syntax checks"
bash -n "${REPO_ROOT}/scripts/check"
for sh_file in "${REPO_ROOT}"/scripts/*.sh; do
  [[ -e "${sh_file}" ]] || continue
  bash -n "${sh_file}"
done
NOTARY_CHECK="${CODING_REWIND_NOTARY_CHECK:-${HOME:-}/Projects/agent-home/tools/notary-check/check_notary_policy.py}"
if [[ -f "${NOTARY_CHECK}" ]]; then
  python3 -B "${NOTARY_CHECK}" "${REPO_ROOT}"
fi

echo "==> [6/6] AppIcon & MenuBarIcon geometry verification"
mkdir -p "${REPO_ROOT}/.build"
ICON_CHECK_ROOT="$(mktemp -d "${REPO_ROOT}/.build/icon-check.XXXXXX")"
trap 'rm -r "${ICON_CHECK_ROOT}"' EXIT
ICONSET_CHECK_DIR="${ICON_CHECK_ROOT}/AppIcon.iconset"
swift "${REPO_ROOT}/scripts/generate-app-icons.swift" "${ICONSET_CHECK_DIR}"
swift "${REPO_ROOT}/scripts/verify-app-icon.swift" "${ICONSET_CHECK_DIR}" "${REPO_ROOT}/Resources"
python3 "${REPO_ROOT}/scripts/test-app-icon.py" "${ICONSET_CHECK_DIR}" "${REPO_ROOT}/Resources"
rm -r "${ICON_CHECK_ROOT}"
trap - EXIT

"${REPO_ROOT}/scripts/test-bundle-signing.sh"

if [[ -d "${REPO_ROOT}/dist" ]]; then
  echo "FAIL: dist directory was created during verification" >&2
  exit 1
fi

rm -rf "${REPO_ROOT}/.test-data"

python3 - <<'PY_FINAL'
import pathlib
import sys
pref_dir = pathlib.Path.home() / "Library" / "Preferences"
fixed_qa_suites = {
    "dev.codingrewind.qa.tests.plist",
    "dev.codingrewind.qa.appearance.plist",
    "dev.codingrewind.qa.appearance.popup.plist",
    "dev.codingrewind.qa.upgrade-integrity.plist",
    "dev.codingrewind.qa.shortcuts.8bf5238e9fb55904.plist",
    "dev.codingrewind.qa.shortcuts.a801eac0a75e043c.plist",
    "dev.codingrewind.qa.vendor-tests.plist",
}
for fname in fixed_qa_suites:
    p = pref_dir / fname
    if p.is_file() and p.stat().st_size in (42, 64):
        try:
            p.unlink()
        except OSError:
            pass
for p in pref_dir.glob("dev.codingrewind.qa.shortcuts.*.plist"):
    if p.is_file() and p.stat().st_size in (42, 64):
        try:
            p.unlink()
        except OSError:
            pass

leaked = sorted(
    set(pref_dir.glob("dev.codingrewind.qa.*.plist"))
    | set(pref_dir.glob("dev.codingrewind.tests.*.plist"))
)
if leaked:
    names = ", ".join(p.name for p in leaked)
    print(f"FAIL: QA/test preferences plist remained after check: {names}", file=sys.stderr)
    sys.exit(1)
PY_FINAL

echo "PASS: all verification checks succeeded."
